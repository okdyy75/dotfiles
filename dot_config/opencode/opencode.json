{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "*": "ask",
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "task": "allow",
        "skill": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "external_directory": "ask",
        "doom_loop": "ask",
        "bash": {
            "pwd *": "allow",
            "wc *": "allow",
            "command -v": "allow",
            "git *": "ask",
            "git-cz *": "allow",
            "git remote *": "allow",
            "git branch *": "allow",
            "git fetch origin *": "allow",
            "git show *": "allow",
            "git log *": "allow",
            "git diff *": "allow",
            "git status *": "allow",
            "git switch *": "allow",
            "git add *": "allow",
            "git commit *": "allow",
            "git push origin *": "allow",
            "git cherry-pick *": "allow",
            "gh pr list *": "allow",
            "gh pr view *": "allow",
            "gh pr edit *": "allow",
            "gh pr diff *": "allow",
            "gh pr create *": "ask",
            "gh issue view *": "allow",
            "gh repo view *": "allow",
            "direnv exec . yarn *": "allow",
            "docker compose exec *": "allow",
            "~/cloud-sql-proxy *": "deny",
            "curl *": "deny",
            "wget *": "deny",
            "heroku *": "deny",
            "gcloud *": "deny"
        },
        "serena_*": "allow",
        "playwright_*": "allow"
    },
    "mcp": {
        "serena": {
            "type": "local",
            "command": [
                "uvx",
                "--from",
                "git+https://github.com/oraios/serena",
                "serena",
                "start-mcp-server",
                "--project",
                "$(pwd)"
            ],
            "enabled": true
        },
        "playwright": {
            "type": "local",
            "command": [
                "npx",
                "@playwright/mcp@latest",
                "--caps=devtools"
            ],
            "enabled": true
        }
    }
}
